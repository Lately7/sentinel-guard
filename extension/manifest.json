{
  "manifest_version": 3,
  "name": "Sentinel Guard",
  "version": "0.1.0",
  "description": "Chặn trang lừa đảo, phát tán mã độc, đào coin và quét tệp tải về bằng agent Sentinel Guard trên máy.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "storage",
    "downloads",
    "notifications",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["src/content/page_guard.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Sentinel Guard",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [
    { "resources": ["src/blocked.html", "src/blocked.js", "src/ui.css"], "matches": ["<all_urls>"] }
  ]
}
